# Copy this file to .env and replace values for your environment.

# restic backup configuration
RESTIC_HOST=self-hosted-apps
RESTIC_REPO=/backup/apps-backup
RESTIC_PASSWORD_FILE=/backup/restic-password.txt

# rclone backup configuration
RCLONE_CONFIG_FILE=/backup/rclone.conf
RCLONE_TARGET=dropbox-self-hosted-apps-backup:
